page{background:#f0f5ef;color:#12362e;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}.page{min-height:100vh;padding:28rpx 36rpx 52rpx;box-sizing:border-box;background:#fbfcf7}.brand{font-size:34rpx;font-weight:800;color:#003d31}.eyebrow{font-size:22rpx;letter-spacing:3rpx;color:#6a837a;font-weight:700}.hero{font-size:58rpx;line-height:1.18;letter-spacing:-2rpx;font-weight:800;color:#003d31;margin:48rpx 0 22rpx}.sub{font-size:28rpx;line-height:1.7;color:#637a72}.button{display:block;border:0;border-radius:30rpx;padding:28rpx 30rpx;margin-top:28rpx;font-size:30rpx;font-weight:800;background:#c8ff23;color:#003d31}.button.dark{background:#003d31;color:#fff}.button.ghost{background:#fff;border:2rpx solid #bed0c2;color:#003d31}.button.small{padding:20rpx 24rpx;font-size:26rpx}.card{background:#fff;border:2rpx solid #dce6dd;border-radius:28rpx;padding:30rpx;margin-top:26rpx;box-shadow:0 10rpx 34rpx rgba(16,61,40,.06)}.label{display:block;font-size:24rpx;color:#637a72;font-weight:700;margin:24rpx 0 12rpx}.input,.textarea{width:100%;box-sizing:border-box;background:#fff;border:2rpx solid #dbe5dc;border-radius:22rpx;padding:24rpx;font-size:28rpx;color:#12362e}.textarea{min-height:180rpx}.muted{font-size:24rpx;color:#788e85;line-height:1.6}.flag-title{font-size:38rpx;line-height:1.4;font-weight:800;color:#003d31}.meta{display:flex;gap:22rpx;flex-wrap:wrap;color:#72877e;font-size:24rpx;margin-top:18rpx}.tag{display:inline-block;background:#eaf1e9;border-radius:999rpx;padding:10rpx 16rpx;font-size:22rpx;color:#4e6c61}.result{padding:36rpx;border-radius:28rpx;margin-top:28rpx;background:#edf7d4}.result.bad{background:#f6eee7}.result-title{font-size:52rpx;font-weight:800;color:#003d31}.bottom{display:flex;gap:20rpx;margin-top:40rpx}.bottom button{flex:1}
