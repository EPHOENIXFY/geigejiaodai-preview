<view class="page"><view class="eyebrow">MY FLAGS</view><view class="hero" style="font-size:48rpx">我的 FLAG</view><view wx:for="{{all}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="tag">{{item.result?(item.result==='done'?'站住了':'没站住'):'进行中'}}</view><view class="flag-title" style="margin-top:18rpx">{{item.goal}}</view><view class="meta"><text>到 {{item.deadline}}</text><text wx:if="{{item.result}}">{{item.resultAt}}</text></view></view><view wx:if="{{!all.length}}" class="muted">还没有。先立一面。</view></view>