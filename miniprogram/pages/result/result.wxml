<view class="page" wx:if="{{item}}"><view class="eyebrow">给个交代</view><view class="hero" style="font-size:48rpx">到时间了。<br/>做成了吗？</view><view class="card"><view class="flag-title" style="font-size:32rpx">{{item.goal}}</view><view class="muted" style="margin-top:16rpx">当时说：{{item.criteria}}</view></view><view class="bottom"><button class="button {{choice==='done'?'dark':''}}" data-choice="done" bindtap="choose">做成了</button><button class="button ghost" data-choice="not_done" bindtap="choose">没做成</button></view><textarea class="textarea" style="margin-top:28rpx" placeholder="拿出什么结果，或者后来发生了什么？" bindinput="onTextInput"></textarea><button class="button" bindtap="finish">说完了　→</button></view>