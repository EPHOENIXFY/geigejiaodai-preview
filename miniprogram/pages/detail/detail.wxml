<view class="page" wx:if="{{item}}"><view class="eyebrow">回来看看</view><view class="hero" style="font-size:48rpx">{{item.goal}}</view><view class="meta"><text class="tag">私人保存</text><text>到 {{item.deadline}}</text></view><view class="card"><view class="label" style="margin-top:0">做到什么才算完成</view><view class="sub">{{item.criteria}}</view></view><view class="eyebrow" style="margin-top:48rpx">留一点进展</view><textarea class="textarea" placeholder="说两句……" value="{{progress}}" bindinput="onProgressInput"></textarea><button class="button small" bindtap="add">记下来</button><button class="button dark" bindtap="result">到时间了，给个结果　→</button><view class="eyebrow" style="margin-top:48rpx">已经留下的</view><view wx:for="{{item.logs}}" wx:key="at" class="card"><view class="muted">{{item.at}}</view><view style="font-size:28rpx;margin-top:10rpx">{{item.text}}</view></view></view>